// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.sqlite3"
}

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique
  password_hash  String
  role           String
  created_at     DateTime   @default(now()) @map("created_at")
  updated_at     DateTime   @updatedAt @map("updated_at")

  audit_logs     AuditLog[]

  @@map("users")
}

model Client {
  id          Int      @id @default(autoincrement())
  dni         String   @unique
  name        String
  phone       String?
  code        String   @unique
  tax_id      String?  @unique
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  sales       Sale[]

  @@index([name])
  @@index([dni])
  @@map("clients")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  products    Product[]

  @@map("categories")
}

model Product {
  id               Int       @id @default(autoincrement())
  sku              String    @unique
  name             String
  description      String?
  category_id      Int?
  category         Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  price_purchase   Float     @map("price_purchase")
  price_sale       Float     @map("price_sale")
  stock            Int       @default(0)
  min_stock        Int?      @default(5)
  created_at       DateTime  @default(now()) @map("created_at")
  updated_at       DateTime  @updatedAt @map("updated_at")
  supplier_id      Int?
  supplier         Supplier? @relation(fields: [supplier_id], references: [id])

  inventory_movements InventoryMovement[]
  sale_items       SaleItem[]
  purchase_items   PurchaseItem[] @relation("ProductPurchaseItems")

  @@index([category_id])
  @@index([stock, min_stock])
  @@index([name])
  @@index([sku])
  @@index([supplier_id])
  @@map("products")
}

model CashRegister {
  id             Int        @id @default(autoincrement())
  opened_at      DateTime   @default(now()) @map("opened_at")
  opening_amount Float      @map("opening_amount")
  total_sales    Float      @default(0) @map("total_sales")
  closed_at      DateTime?  @map("closed_at")
  closing_amount Float?     @map("closing_amount")
  difference     Float?
  status         String?    // PERFECT, SURPLUS, MISSING
  created_at     DateTime   @default(now()) @map("created_at")
  updated_at     DateTime   @updatedAt @map("updated_at")

  sales          Sale[]

  @@map("cash_registers")
}

model Sale {
  id               Int        @id @default(autoincrement())
  cash_register_id Int
  cash_register    CashRegister @relation(fields: [cash_register_id], references: [id])
  client_id        Int
  client           Client     @relation(fields: [client_id], references: [id])
  total            Float
  subtotal         Float      @default(0)
  tax_amount       Float      @default(0)
  payment_method   String?    @default("CASH") @map("payment_method")
  exchange_rate    Float      @default(0) @map("exchange_rate")
  created_at       DateTime   @default(now()) @map("created_at")
  updated_at       DateTime   @updatedAt @map("updated_at")

  items            SaleItem[]

  @@index([cash_register_id])
  @@index([client_id])
  @@index([created_at])
  @@index([cash_register_id, created_at])
  @@index([client_id, created_at])
  @@index([payment_method])
  @@map("sales")
}

model SaleItem {
  id              Int      @id @default(autoincrement())
  sale_id         Int
  sale            Sale     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product_id      Int
  product         Product  @relation(fields: [product_id], references: [id])
  quantity        Int
  unit_price      Float
  purchase_price  Float
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")

  @@index([sale_id])
  @@index([product_id])
  @@map("sale_items")
}

model InventoryMovement {
  id          Int      @id @default(autoincrement())
  product_id  Int
  product     Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  type        String   // ENTRADA | SALIDA
  quantity    Int
  reason      String?  // Ej: COMPRA, AJUSTE, DEVOLUCION, VENTA
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  @@index([product_id])
  @@index([type])
  @@index([product_id, created_at])
  @@index([product_id, type])
  @@map("inventory_movements")
}

model Supplier {
  id          Int       @id @default(autoincrement())
  name        String
  ruc         String?  @unique
  phone       String?
  email       String?
  address     String?
  created_at  DateTime  @default(now()) @map("created_at")
  updated_at  DateTime  @updatedAt @map("updated_at")
  
  products    Product[]
  purchases   Purchase[]
  
  @@map("suppliers")
}

model Purchase {
  id           Int           @id @default(autoincrement())
  supplier_id  Int
  supplier     Supplier      @relation(fields: [supplier_id], references: [id])
  total_amount Float         @map("total_amount")
  status       String        @default("PENDING") // PENDING, RECEIVED, CANCELLED
  payment_status String    @default("UNPAID") // UNPAID, PAID
  created_at   DateTime       @default(now()) @map("created_at")
  updated_at   DateTime       @updatedAt @map("updated_at")
  
  items        PurchaseItem[]
  
  @@index([supplier_id])
  @@index([status])
  @@index([created_at])
  @@map("purchases")
}

model PurchaseItem {
  id          Int     @id @default(autoincrement())
  purchase_id Int
  purchase    Purchase @relation(fields: [purchase_id], references: [id])
  product_id  Int
  product     Product  @relation(fields: [product_id], references: [id], name: "ProductPurchaseItems")
  quantity    Int
  unit_cost   Float   @map("unit_cost")
  
  @@index([purchase_id])
  @@index([product_id])
  @@map("purchase_items")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  action      String
  entity      String
  entity_id   Int
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  @@index([user_id])
  @@index([entity])
  @@index([created_at])
  @@map("audit_logs")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("settings")
}
